# --- standpoint specifics ---
# (git does NOT support trailing/inline comments — keep patterns on their own line)
# .private/  = private notes, todo, scratch (never committed)
# data/      = private / working input tables
# out/       = generated deliverables (the tracked showcase lives in examples/)
# .deepeval/ = deepeval telemetry / cache
# logs/      = raw training-run stdout/stderr (regenerable by rerunning the
#              launcher scripts; extract_loss_curve.py reads these)
# llm.engine.yaml = machine-specific engine descriptor resolved from the committed
#                   llm.brief.yaml by best-engine-ai-helper; never committed.
.private/
data/
out/
logs/
.deepeval/
standpoint/llm.engine.yaml

# distillation/ — model weights, adapters, and generated datasets are large and
# fully regenerable from the scripts; never committed, EXCEPT the final LoRA
# adapters (best-adapter/, tracked via Git LFS -- see .gitattributes) once a run
# is validated. Everything else under checkpoints/ (base models, intermediate
# training snapshots, toy/experimental runs) stays regenerable and ignored.
# distillation/.venv/ and distillation/data/ are already covered by the generic
# .venv/ and data/ patterns above.
distillation/checkpoints/*
!distillation/checkpoints/distilled-adapter/
distillation/checkpoints/distilled-adapter/*
!distillation/checkpoints/distilled-adapter/best-adapter/
!distillation/checkpoints/distilled-adapter-fr/
distillation/checkpoints/distilled-adapter-fr/*
!distillation/checkpoints/distilled-adapter-fr/best-adapter/

# --- Python bytecode & caches ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / build ---
build/
dist/
*.egg-info/
.eggs/
wheels/
*.egg
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version
.env
.env.*

# --- Test & coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Type / lint caches ---
.ruff_cache/
.mypy_cache/
.pyright/
.dmypy.json

# --- Notebooks ---
.ipynb_checkpoints/

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS cruft ---
.DS_Store
Thumbs.db
